# Postgres connection string (Neon). Copy from the Neon console → Connection Details.
DATABASE_URL=

# Random secret used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google OAuth — console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram Login widget — create a bot via @BotFather, then /setdomain to this app's domain
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# Public URL this app is served from (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary — cloudinary.com console, free tier
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
