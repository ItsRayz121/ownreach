# Postgres connection string (Neon). Copy from the Neon console → Connection Details.
DATABASE_URL=

# Random secret used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google OAuth — console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram login (bot deep-link flow, not the old iframe widget) — reuses the
# existing @ownreach_bot token. TELEGRAM_WEBHOOK_SECRET is any random string
# you also pass as secret_token when calling Telegram's setWebhook.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Public URL this app is served from (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary — cloudinary.com console, free tier
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting (Upstash Redis, free tier) — console.upstash.com → your
# database → REST API. Not required: without these, writes and login
# attempts simply aren't throttled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Realtime DMs/notifications (Ably, free tier) — ably.com/accounts → your
# app → API Keys. Not required: without this, messages and notifications
# still work, just via page navigation/refetch instead of live delivery.
ABLY_API_KEY=
