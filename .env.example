# Postgres connection string (Neon). Copy from the Neon console → Connection Details.
DATABASE_URL=

# Random secret used to sign session tokens. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Google OAuth — console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Telegram login (bot deep-link flow, not the old iframe widget) — reuses the
# existing @ownreach_bot token. TELEGRAM_WEBHOOK_SECRET is any random string
# you also pass as secret_token when calling Telegram's setWebhook.
TELEGRAM_BOT_TOKEN=
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=

# Public URL this app is served from (no trailing slash)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Cloudinary — cloudinary.com console, free tier
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Rate limiting (Upstash Redis, free tier) — console.upstash.com → your
# database → REST API. Not required: without these, writes and login
# attempts simply aren't throttled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Realtime DMs/notifications (Ably, free tier) — ably.com/accounts → your
# app → API Keys. Not required: without this, messages and notifications
# still work, just via page navigation/refetch instead of live delivery.
ABLY_API_KEY=

# Passwordless email sign-in (Resend, free tier) — resend.com → API Keys.
# EMAIL_FROM must be a sender verified on your Resend domain, e.g.
# "OwnReach <login@yourdomain.com>". Required for the "Continue with email"
# option specifically; every other login method works without it.
RESEND_API_KEY=
EMAIL_FROM=

# Post creation is restricted to admin-approved creators plus these
# comma-separated, exact-match email addresses (official platform accounts).
OFFICIAL_POST_EMAILS=

# Secret Vercel Cron sends as `Authorization: Bearer <value>` when it hits
# /api/cron/* routes (see vercel.json) — Vercel does this automatically for
# an env var named exactly CRON_SECRET. Generate the same way as AUTH_SECRET.
# Without it, /api/cron/purge-expired-media just 503s and chat photos are
# never purged once their retention window (lib/media-retention.ts) passes —
# not required for the app to otherwise function, just for that cleanup.
CRON_SECRET=
